# Select the API site. Use "official" for OpenAI, or a descriptive name
# such as "my-relay" for an OpenAI-compatible relay.
OPENAI_SITE=official

# API root URL for a relay, usually ending in /v1. It is ignored when
# OPENAI_SITE=official. Remote sites must use HTTPS; localhost may use HTTP.
OPENAI_BASE_URL=

# Structured-output endpoint supported by the selected site:
# responses or chat_completions.
OPENAI_API_MODE=responses

# API key issued by the selected site. Never commit the real value.
OPENAI_API_KEY=

# Model name available at the selected site.
OPENAI_MODEL=gpt-5.6

# Local SQLite database path.
DATABASE_URL=sqlite:///./work_memory.db

# Conservative risk-gating defaults. Tune only with evaluation data.
AUTO_ARCHIVE_CONFIDENCE=0.85
CONFIRM_CONFIDENCE=0.55
