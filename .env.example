# OpenAI API key for LLM classification and extraction.
OPENAI_API_KEY=

# Default model. Adjust according to your OpenAI account/model availability.
OPENAI_MODEL=gpt-5.6

# Local SQLite database path.
DATABASE_URL=sqlite:///./work_memory.db

# Conservative risk-gating defaults. Tune only with evaluation data.
AUTO_ARCHIVE_CONFIDENCE=0.85
CONFIRM_CONFIDENCE=0.55
