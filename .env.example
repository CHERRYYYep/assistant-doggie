# TypeScript doggie-local-web loads this file from the current directory.
# Process environment variables take precedence over values in this file.

# Model endpoint selection.
OPENAI_SITE=official
# Required for an OpenAI-compatible relay; leave empty for the official site.
# Use the API root (usually ending in /v1), not /responses or /chat/completions.
OPENAI_BASE_URL=
# Supported values: responses or chat_completions.
OPENAI_API_MODE=responses
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
# Integer seconds for each model HTTP request; accepted range: 1-300.
OPENAI_TIMEOUT_SECONDS=30

# Doggie local Web UI. Only literal 127.0.0.1 or [::1] listeners are accepted.
# Prefer an absolute database path so Web, Claude and Codex share one file.
DOGGIE_DATABASE_PATH=doggie.db
DOGGIE_SERVER_ADDRESS=127.0.0.1:8787
