{
  "name": "doggie",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first personal work-memory agent",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test 'tests/**/*.test.ts' 'src/**/*.test.ts'",
    "test:web": "node --test --test-isolation=none 'web/tests/**/*.test.ts'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test && npm run test:web",
    "mcp": "node src/mcp/main.ts",
    "start": "node src/main.ts"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^26.2.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "hono": "^4.13.3",
    "zod": "^4.4.3"
  },
  "bin": {
    "doggie-mcp": "bin/doggie-mcp"
  }
}
