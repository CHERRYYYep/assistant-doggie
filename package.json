{
  "name": "doggie",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first personal work-memory agent",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit",
    "build:web": "vite build --config web/vite.config.ts",
    "test": "node --test 'tests/**/*.test.ts' 'src/**/*.test.ts' 'scripts/**/*.test.ts'",
    "test:web": "node --test --test-isolation=none 'web/tests/**/*.test.ts'",
    "d3:l0": "node scripts/d3/run.ts",
    "d3:l1": "node scripts/d3/live-l1.ts",
    "d3:matrix": "node --test scripts/d3/source-guard.test.ts scripts/d3/fault-matrix.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm run typecheck:web && npm run build:web && npm run openapi:check && npm test && npm run test:web",
    "mcp": "node src/mcp/main.ts",
    "start": "node src/main.ts",
    "openapi:generate": "node scripts/openapi.ts --write",
    "openapi:check": "node scripts/openapi.ts --check"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.2.0",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "lucide-react": "^1.80.0",
    "prettier": "^3.9.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "hono": "^4.13.3",
    "zod": "^4.4.3"
  },
  "bin": {
    "doggie-mcp": "bin/doggie-mcp"
  }
}
